# 默认仅本机可访问；复制后由 Node --env-file 加载，npm start 不自动读取 .env。
NODE_ENV=production
TVBOX_HOST=127.0.0.1
TVBOX_PORT=4781
# 局域网或域名访问时，填写用户浏览器地址（多个用逗号分隔）。
# TVBOX_HOST=0.0.0.0
# TVBOX_ORIGINS=http://192.168.1.10:4781,https://tv.example.com
TVBOX_ORIGINS=
# 网盘登录仅保存在此后端目录，默认工作目录下 .tvbox-data（已加入 Git 忽略）。
# 多实例或验收环境须使用独立目录；家庭服务重启时保持相同路径。
# TVBOX_DATA_DIR=/absolute/path/to/tvbox-private-data
